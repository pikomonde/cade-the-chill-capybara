PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Auth
JWT_SECRET=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Reward Signer (backend's Ethereum wallet — private key!)
# This address must be set as trustedSigner in GameReward.sol
SIGNER_PRIVATE_KEY=replace-with-your-signer-private-key-no-0x

# Game
SERVER_SECRET=replace-with-long-random-string-for-commitment-hash

# Blockchain
CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org

# Contract Addresses (fill after deployment)
CONTRACT_CADE_COIN=
CONTRACT_CADE_BADGE=
CONTRACT_GAME_REWARD=
CONTRACT_SUBSCRIPTION=
CONTRACT_BADGE_MARKET=
